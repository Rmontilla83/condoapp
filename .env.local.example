# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dominio canónico del portal (usado en los QR de visitantes, sitemap, etc.)
# En prod: https://portal.atryum.net . En dev se puede omitir (cae a window.location.origin).
NEXT_PUBLIC_PORTAL_URL=https://portal.atryum.net

# Correo transaccional (Resend). El dominio atryum.net ya está verificado.
# Si falta, la app NO envía correos pero todo lo demás funciona igual.
# Producción: vercel env add RESEND_API_KEY production
RESEND_API_KEY=re_xxxxxxxxxxxx
